// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Shared per-country info - added 2026-08-28 so cities in the same country
// (Barcelona, Madrid, Valencia, ...) share one currency record instead of
// each City repeating (and risking drift on) the same currencyName/
// currencySymbol. Also replaces the old free-text City.country String,
// which had no consistency guarantee across rows (e.g. "Spain" vs "spain").
// Roles for team accounts - Admin manages users and has full Editor
// capabilities; Editor can edit and publish any entry; Creator can create
// and edit entries but can never set status to PUBLISHED (enforced
// server-side, not just hidden in the UI). See claude/todo.md.
enum Role {
  ADMIN
  EDITOR
  CREATOR
}

// Entry.status below - Draft is the safe default (new entries start
// invisible on the public site); Awaiting Review is optional (a creator
// can flag a draft as ready, but editors/admins can publish straight from
// Draft too - review isn't a hard gate for them). Only PUBLISHED entries
// are ever returned to an unauthenticated request.
enum EntryStatus {
  DRAFT
  AWAITING_REVIEW
  PUBLISHED
}

// A team account (admin/editor/creator), not a consumer user account -
// see claude/todo.md's "User accounts / login" items for the separate
// (and deliberately deferred) consumer-facing login discussion.
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
}

model Country {
  id             Int     @id @default(autoincrement())
  name           String  @unique
  currencyName   String?
  currencySymbol String?
  // ISO 3166-1 alpha-2 code (e.g. "ES", "FR") - added 2026-09-11 alongside
  // the Public Holidays feature (see claude/public-holidays-spec.md), which
  // needs it to call the Nager.Date API (GET .../PublicHolidays/{year}/{code}).
  // Optional/nullable and hand-set in Prisma Studio, same pattern as
  // City.countryId/timezone below - existing Country rows (France, Spain,
  // ...) predate this and need backfilling; a city whose country has no
  // code set just doesn't show a Public Holidays row (see
  // GET /api/cities/:cityId/holidays) rather than guessing one.
  code           String? @unique
  cities         City[]
}

model City {
  id            Int            @id @default(autoincrement())
  name          String
  latitude      Float
  longitude     Float
  // URL of the city's cover photo, hosted on Cloudinary - same pattern as
  // Entry.photoUrl below (null falls back to the static placeholder image
  // in Home.jsx). See claude/todo.md for the hosting-provider decision
  // (2026-08-29: Cloudinary, free tier). No in-app upload UI for this yet -
  // set by hand in Prisma Studio, same as latitude/longitude/countryId
  // below, since City has no in-app editor at all currently.
  photoUrl      String?
  // Optional rather than required: existing City rows (Lyon, Barcelona)
  // predate this relation and need backfilling by hand in Prisma Studio
  // after this migration applies - a required relation can't be added in
  // the same migration that drops the old `country` String column, since
  // there'd be nothing yet to point existing rows at. Tighten to required
  // once every City has a countryId set - see claude/todo.md.
  country       Country?       @relation(fields: [countryId], references: [id])
  countryId     Int?
  // IANA timezone identifier for this city (e.g. "Europe/Madrid",
  // "Europe/Paris"), used to compute "is this entry open now" from
  // Entry.openingTimes in the restaurant's own local time rather than the
  // viewer's device time - see client/src/openingHours.js and the discussion
  // in claude/todo.md (2026-09-02). Optional and hand-set in Prisma Studio
  // like photoUrl/latitude/longitude above, since City has no in-app
  // editor - existing rows (Lyon, Barcelona, The Hague) need backfilling
  // after this migration applies, and the open-now badge/filter simply
  // stays hidden for any city left blank rather than guessing.
  timezone      String?
  // Region within this city's country, for the Public Holidays feature
  // (added 2026-09-11, see claude/public-holidays-spec.md) - Spain's
  // autonomous communities (Catalonia, Madrid, ...) each get their own
  // holidays on top of the national ones, and Nager.Date tags those with an
  // ISO 3166-2 subdivision code (e.g. "ES-CT" for Catalonia) rather than
  // returning them per-city. subdivisionCode is what GET
  // /api/cities/:cityId/holidays matches against; subdivisionName is a
  // plain display label (e.g. "Catalonia") shown as a tag on a regional
  // holiday, since deriving a human-readable name from the ISO code would
  // need its own lookup table for no real benefit at this scale. Both
  // optional and hand-set in Prisma Studio, same pattern as
  // timezone/countryId above - a city with neither set only ever sees
  // nationwide holidays, never a guessed region.
  subdivisionCode String?
  subdivisionName String?
  entries       Entry[]
  // Opposite side of ActivityType.city - a city's activity "type" groupings
  // (Laser Tag, Padel, ...). See ActivityType below for the full rationale.
  activityTypes ActivityType[]
  // Named areas/districts within this city, shown as pins on the
  // Neighbourhoods map screen - see Neighbourhood below.
  neighbourhoods Neighbourhood[]
}

model Category {
  id      Int     @id @default(autoincrement())
  slug    String  @unique
  name    String
  entries Entry[]
}

// A named area/district within a city, shown as a pin on the dedicated
// Neighbourhoods map screen (client/src/Neighbourhoods.jsx) - added
// 2026-08-31 so a first-time visitor can get oriented (where is Gracia,
// what's near it) before diving into Eating Out/Activities/Sightseeing,
// and so someone deciding where to stay can compare areas. See the
// "Neighbourhoods" discussion in claude/home-screen-spec.md for the
// fuller reasoning.
//
// Deliberately just a centroid point for now (latitude/longitude, plain
// Float - same convention City/Entry already use), not a real boundary
// polygon. A pin on a real map already conveys rough position and what's
// adjacent; filled boundary shapes would need real geometry (hand-traced
// or sourced from OSM) that's a bigger content lift, and PostGIS isn't
// used elsewhere in this schema for the same reason - revisit only if/
// when boundary-based queries or fills are actually wanted.
model Neighbourhood {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String
  latitude    Float
  longitude   Float
  description String?
  city        City    @relation(fields: [cityId], references: [id])
  cityId      Int

  // Slugs are unique per city rather than globally, same reasoning as
  // ActivityType.slug above - e.g. a "gracia" slug can exist independently
  // in both Barcelona and a future city without colliding.
  @@unique([cityId, slug])
}

// Local cache of Nager.Date's public-holiday data (added 2026-09-11, see
// claude/public-holidays-spec.md for the full design discussion behind the
// Public Holidays feature). One row per holiday per country per year -
// Nager.Date returns every holiday for a country in a single call (both
// nationwide ones and region-specific ones together), so this caches that
// whole response rather than one row per city; GET /api/cities/:cityId/
// holidays filters down to what's relevant for one city at query time
// (global === true, or subdivisionCodes includes that city's own
// City.subdivisionCode).
//
// Deliberately NOT keyed by city - two cities in the same country
// (Barcelona, Madrid) share one cached fetch instead of each re-hitting
// Nager.Date for the same country/year. Refetched lazily (see
// ensureHolidaysCached in server/index.js): checked on the first request
// for a given country/year, left alone after that for the rest of that
// year, since a year's holiday dates don't change once published.
model PublicHoliday {
  id               Int      @id @default(autoincrement())
  // ISO 3166-1 alpha-2, e.g. "ES" - matches Country.code above.
  countryCode      String
  year             Int
  date             DateTime @db.Date
  // Nager.Date's own two name fields - localName is in the country's own
  // language (e.g. "Día de Navidad"), name is the English translation.
  // Both kept since which one reads better varies (a Catalan/Spanish name
  // can be more recognisable locally than its English translation, or vice
  // versa) - the client currently shows localName, see PublicHolidays.jsx.
  localName        String
  name             String
  // true for a nationwide holiday; false means it's restricted to the
  // regions listed in subdivisionCodes below (Nager.Date's own `global`
  // field, passed straight through).
  global           Boolean  @default(true)
  // ISO 3166-2 codes this holiday applies to when NOT global (Nager.Date's
  // `counties` field, renamed here since "county" reads as a much smaller
  // unit than what these actually are - Spain's codes are its autonomous
  // communities, e.g. "ES-CT" for Catalonia, not provinces or municipalities
  // - see the City.subdivisionCode comment above). Empty array when global
  // is true.
  subdivisionCodes String[] @default([])

  // One row per distinct holiday per country/year - guards against a
  // duplicate insert if ensureHolidaysCached() is ever called twice for the
  // same country/year in a race (e.g. two concurrent requests before either
  // finishes caching).
  @@unique([countryCode, year, date, localName])
}

// Editorial "why"/"what to expect" content for a recurring public holiday
// (added 2026-09-11 alongside PublicHoliday above) - written once per
// holiday, not per year, since what a holiday commemorates and what to
// expect while it's on barely changes year to year even though its actual
// date does (a fixed-date holiday moves within the week, a lunar/religious
// one moves more). Keyed by a stable, hand-chosen `slug` rather than by
// date/year for exactly that reason - see claude/public-holidays-spec.md.
//
// Matched to a live PublicHoliday row at request time (see matchInfo() in
// server/index.js) by checking whether that holiday's localName or name
// appears in matchNames - a small array rather than a single expected
// string because Nager.Date's exact wording for a given holiday isn't
// guaranteed to stay byte-for-byte identical across years (accents,
// capitalisation, minor rephrasing), so a couple of known variants is more
// resilient than one exact match. A PublicHoliday with no matching row here
// still shows on the list (date/name/tags) - it just isn't tappable through
// to a detail screen, see PublicHolidays.jsx. There is no city/country
// scoping on this model itself - matching happens purely by name text, so
// the same slug/content would also serve another city that happens to share
// a holiday name, without needing its own copy.
model HolidayInfo {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  matchNames   String[] @default([])
  // "About this day" - the holiday's history/significance, written in the
  // app's own editorial voice (same principle as Entry.description
  // elsewhere - see claude/todo.md's "Editorial copy is never for sale").
  description  String
  // "What to expect" - practical, traveler-facing notes (closures, likely
  // crowds/transport impact). Optional, since a quiet family holiday (e.g.
  // Sant Esteve) may not need one the way a day with citywide
  // demonstrations (e.g. the Diada) does.
  whatToExpect String?
}

// Broader interest groupings that ActivityType rows can optionally belong to
// (Sport & Active, Culture & Arts, Outdoors & Nature, Fun & Entertainment) -
// added 2026-09-10 so someone who only wants, say, sport-adjacent activities
// can filter the Activities screen down to just those instead of scanning
// every ActivityType in the city (see the always-visible filter-chip row in
// client/src/CategoryScreen.jsx). One level up from ActivityType, the same
// way ActivityType sits one level up from Entry - a real, separate model
// rather than a free-text tag, for the same reason ActivityType itself is:
// the group list is small and fixed (four for now, see
// client/src/categoryConfig.js/seed.js), not something anyone types freely,
// so there's no spelling-drift risk a lookup table needs to solve (contrast
// Entry.types, which deliberately stays free text - see that field's
// comment below). Simply cleaner to reference a real row than to hardcode
// four magic strings in both the schema and the client.
//
// Shared globally, unlike ActivityType (which is scoped per-city) - "Sport &
// Active" means the same thing in every city, there's no per-city
// description to duplicate/collide the way ActivityType.description can
// (see that model's comment below), so there's nothing to gain from scoping
// this to a city and real cost (every city would otherwise need its own
// copy of the same four rows).
model ActivityGroup {
  id            Int            @id @default(autoincrement())
  name          String
  slug          String         @unique
  // Manual display order for the filter-chip row - same mechanism/rationale
  // as ActivityType.sortOrder below. Alphabetical would put "Culture & Arts"
  // before "Sport & Active" for no good reason; this lets the four be
  // ordered deliberately instead (see seed.js).
  sortOrder     Float          @default(0)
  activityTypes ActivityType[]
}

// Groups multiple provider Entries under one activity "type" (e.g. Laser
// Tag, Padel, Escape Rooms) - added 2026-08-28 because, unlike Sightseeing
// or Eating Out where each Entry is a unique, non-substitutable thing,
// Activities often has one generic experience offered by several roughly
// interchangeable providers. The Activities category screen is meant to
// list ActivityType cards (not Entry cards directly); tapping one shows
// its description plus its provider Entries as mini-cards.
//
// Scoped per-city (cityId required), not shared globally like Country -
// deliberately, so a type with zero providers is unambiguous (it means
// "this city has this activity, described, just not broken out by
// provider" rather than colliding with "not curated yet" or "this city
// doesn't have this activity at all"). Revisit sharing across cities only
// if duplicate descriptions (e.g. re-explaining what padel is per city)
// become a proven pain - same reasoning that delayed the Country model
// until there were actually multiple Spanish cities to justify it.
model ActivityType {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String
  // Optional short, punchy blurb for card display - same idea as
  // Entry.summary above. NOTE the fallback order here is the reverse of
  // Entry's: on the group card (see client/src/EntryCard.jsx) `description`
  // is shown when present, falling back to `summary` only when description
  // is blank. That's the opposite of Entry, where summary takes priority.
  // Reasoning: for a provider Entry, summary is a deliberately-written hook
  // that's *better* than the full description snippet, so it should win.
  // For an ActivityType, description is the primary "what is this activity"
  // explanation (see below) - summary here is just a shorter fallback for
  // when no description has been written yet, not a preferred override.
  summary     String?
  // Short explanation of the activity itself - optional, since something
  // self-explanatory (Laser Tag) doesn't need one but something less
  // widely known outside the city (Padel) benefits from a line of context
  // shown above its provider list. Also what's shown when there are no
  // providers below it (see note above) - the type card behaves like a
  // text-only reference entry in that case.
  description String?
  city        City    @relation(fields: [cityId], references: [id])
  cityId      Int
  // Optional broader grouping (Sport & Active, Culture & Arts, ...) shown as
  // filter chips on the Activities screen - see ActivityGroup above.
  // Optional rather than required: existing ActivityType rows (Laser Tag,
  // Padel, ...) predate this relation and need assigning by hand in Prisma
  // Studio after this migration applies, same pattern as
  // City.countryId/timezone elsewhere in this schema. An ungrouped
  // ActivityType still shows under "All" (the default, unfiltered view) -
  // it just never matches a specific group chip, same as an Entry with no
  // `types` never matching a cuisine chip.
  group       ActivityGroup? @relation(fields: [groupId], references: [id])
  groupId     Int?
  // Manual display order among ActivityType cards on the Activities
  // screen - same mechanism/rationale as Entry.sortOrder below.
  sortOrder   Float   @default(0)
  entries     Entry[]

  // Slugs are unique per city rather than globally, since types are
  // per-city - e.g. a "padel" slug can exist independently in both
  // Barcelona and a future city without colliding.
  @@unique([cityId, slug])
}

model Entry {
  id             Int           @id @default(autoincrement())
  name           String
  // Optional short, punchy blurb for card display. When present, the card
  // shows this instead of a truncated snippet of `description` - lets an
  // entry get a hand-written hook instead of relying on the first line of
  // the full description reading well out of context. Falls back to
  // `description` when blank (see client/src/EntryCard.jsx).
  summary        String?
  description    String?
  // address/latitude/longitude: editable from EntryEditor.jsx (2026-09-05)
  // - latitude/longitude can be looked up automatically from the address
  // via GET /api/geocode (OpenStreetMap Nominatim), but that's a starting
  // point to verify, not guaranteed precise - see claude/todo.md's
  // "Automate lat/long lookup" item. priceLevel/rating (below) are still
  // Prisma-Studio-only.
  address        String?
  latitude       Float?
  longitude      Float?
  priceLevel     Int?
  // Free-text "headline" price line for entries that don't fit
  // priceLevel's restaurant-style $/$$/$$$ scale - Sightseeing admission is
  // the motivating case (2026-09-06): a single scale doesn't capture "how
  // much", and a full adult/child/senior/student tariff table is both too
  // long for a mobile screen and a maintenance burden to keep current. So
  // this is deliberately a short, hand-curated summary rather than an
  // exhaustive breakdown - e.g. "€12, kids free" or "Free" or "€15, less
  // with the city pass" - prioritising the base price plus at most one
  // notable exception. Anything more detailed than that belongs in
  // `description` instead (e.g. under its own "Prices" heading), which
  // already exists for arbitrarily long content. Editable via
  // EntryEditor.jsx, unlike priceLevel/rating which stay Prisma-Studio-
  // only - see that field's hint text for the same "keep it short"
  // guidance surfaced to whoever's entering data.
  priceInfo      String?
  // URL of the entry's photo, hosted on Cloudinary - null falls back to
  // the static placeholder image in EntryCard.jsx. See claude/todo.md for
  // the hosting-provider decision (2026-08-29: Cloudinary, free tier).
  photoUrl       String?
  // Free-text sub-classification labels for an entry - cuisines for
  // restaurant-variant entries (e.g. "Tapas", "Catalan" on one pinchos bar,
  // or "Japanese"/"Mexican" on a fusion place), or place types for
  // photo/venue-variant entries like Sightseeing (e.g. "Museum",
  // "Building"). Generic on purpose (renamed from `cuisine` 2026-08-28) so
  // one field/filter mechanism serves every category instead of each
  // needing its own differently-named column.
  //
  // Array rather than a single String (changed 2026-08-30) - raised once
  // the user pointed out a restaurant can genuinely belong to more than one
  // cuisine (a pinchos-and-Catalan place, a Japanese/Mexican fusion
  // restaurant), which a single value couldn't represent. A plain Postgres
  // string array, not a separate lookup table with a many-to-many relation
  // - stays free text/no new model, matching how every other field here
  // has been kept simple until real volume justifies more structure (same
  // reasoning as `summary`/`cuisine` originally). The tradeoff: this is
  // still free text, so the existing spelling-drift risk ("Tapas" vs
  // "tapas" showing as separate filter chips - see EntryEditor.jsx) now
  // applies per-value instead of per-entry. A proper Cuisine/EntryType
  // lookup table (pick from existing values instead of retyping them)
  // would fix multi-value *and* spelling drift together, logged as a
  // heavier follow-up in claude/todo.md rather than built now.
  types          String[] @default([])
  // Contact/practical-info fields, added 2026-09-02 for Eating Out (raised
  // alongside the front-card display of phone below) but left on the
  // shared Entry model rather than a category-specific one, same reasoning
  // as `types`/`photoUrl` - any category with a real-world venue could
  // plausibly want these later (e.g. a museum's phone/website/hours under
  // Sightseeing), even though only Eating Out populates them for now.
  //
  // phone: free text rather than a validated/normalized format, so
  // whatever the user actually dials works (country code, spacing, etc.)
  // without fighting a parser. Rendered as a tel: link wherever it's shown
  // (EntryCard.jsx's front card, EntryDetail.jsx) so tapping it calls the
  // restaurant directly instead of just displaying the digits.
  phone          String?
  // website: free text, not validated as a URL at save time (see
  // EntryEditor.jsx) - a bare domain like "restaurant.com" is accepted and
  // normalized with a https:// prefix only at render time
  // (EntryDetail.jsx's normalizeWebsiteUrl), so entering it without a
  // scheme still produces a working link.
  website        String?
  // openingTimes: a single free-text string, not structured per-day/time
  // data - e.g. "Mon: 7.30pm to 11.30pm, Tue-Sat: 1pm to 3.45pm & 7.30pm
  // to 11.30pm". Convention (settled 2026-09-02, a few hours after this
  // field shipped, once actual typing habits diverged from the first
  // guess): a comma separates day-range clauses, "&" separates multiple
  // time windows within one clause (a lunch/dinner split), a colon
  // separates the day range from its hours, and minutes use a period
  // ("7.30pm") rather than a colon - chosen specifically because it stays
  // easy to read/type as plain text now AND splits cleanly if this ever
  // becomes real structured data later. A semicolon (instead of a comma)
  // and a colon (instead of a period, for minutes) are also still
  // accepted - that was the original convention this field shipped with,
  // so already-entered values keep parsing. See client/src/openingHours.js
  // for the full parser and its "open now" logic - built the same day,
  // once the string had actually been used enough to know it needed
  // parsing (see claude/todo.md's "Structured opening hours" item).
  // Rendered by splitting on "," or ";" for one clause per line
  // (EntryDetail.jsx) - purely a display convenience there, separate from
  // the real parsing openingHours.js does for the "open now" badge/filter.
  openingTimes   String?
  // Internal-only scratch space for whoever's editing an entry - ideas,
  // half-formed copy, a reminder to double-check a fact, something to
  // maybe fold into `description` later. Added 2026-09-02. Deliberately
  // never read by any user-facing screen (EntryCard.jsx, EntryDetail.jsx,
  // ActivityTypeDetail.jsx) - only EntryEditor.jsx shows it, at the
  // bottom of the form, below Description. Note this is a normal Prisma
  // column like every other Entry field: the GET endpoints below return
  // the full row with no `select` restriction, so it does travel over
  // the API response even though nothing renders it - same trust model
  // as the rest of the app (see the no-auth-on-writes gap logged in
  // claude/todo.md/dev-workflow.md), not a hard privacy boundary.
  notes          String?
  rating         Float?
  // Publish workflow (added 2026-09-08) - DRAFT is the real DB-level
  // default so any code path that forgets to set this explicitly fails
  // safe (invisible) rather than silently going live. The migration that
  // introduces this column backfills every pre-existing row to PUBLISHED
  // in the same step - see that migration's .sql for the one-time UPDATE.
  // Server-side enforced, not just hidden in the client: POST/PATCH
  // /api/entries rejects a CREATOR trying to set this to PUBLISHED.
  status         EntryStatus   @default(DRAFT)
  city           City          @relation(fields: [cityId], references: [id])
  cityId         Int
  category       Category      @relation(fields: [categoryId], references: [id])
  categoryId     Int
  // Optional link to an ActivityType, set only on provider Entries under
  // the Activities category (e.g. a specific laser tag venue linking back
  // to the "Laser Tag" ActivityType) - null for every entry in every other
  // category, same pattern as other category-specific fields (e.g. `type`)
  // living on the shared Entry model. See ActivityType above.
  activityType   ActivityType? @relation(fields: [activityTypeId], references: [id])
  activityTypeId Int?
  // Manual display order within a category's card list (lower = earlier).
  // Ties break on id (insertion order), so new entries default to last
  // among same-sortOrder items rather than jumping around unpredictably.
  // Float rather than Int (changed 2026-08-28, was Int @default(0)) so
  // inserting an entry between two existing ones is always just "set it to
  // the number halfway between their two values" - e.g. between 3 and 4 ->
  // 3.5, then between 3 and 3.5 -> 3.25, and so on - without ever having to
  // renumber the rest of the list to make room. See "Entry ordering" in
  // claude/home-screen-spec.md for the fuller reasoning. Set by hand in
  // Prisma Studio for now - not exposed in the in-app editor, which is
  // deliberately scoped to text fields only (name/summary/description). See
  // client/src/CategoryScreen.jsx / the server's entries query for where
  // this is applied.
  sortOrder      Float         @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}
